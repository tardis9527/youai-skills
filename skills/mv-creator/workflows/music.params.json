{
  "description": "music 参数映射，不能拖入 ComfyUI；默认配合技能自带的 music.api.json 执行，工作区同名文件可覆盖。",
  "workflow": "music.api.json",
  "output_ext": [".flac", ".mp3", ".opus", ".wav"],
  "params": {
    "caption": {
      "required": true,
      "targets": [
        {"title": "@caption", "input": "caption"},
        {"class_type": "MiniMaxMusic3TextEncode", "input": "caption"}
      ]
    },
    "lyrics": {
      "targets": [
        {"title": "@lyrics", "input": "lyrics"},
        {"class_type": "MiniMaxMusic3TextEncode", "input": "lyrics"}
      ]
    },
    "max_duration": {
      "targets": [
        {"title": "@duration", "input": "max_duration"},
        {"class_type": "MiniMaxMusic3TextEncode", "input": "max_duration"}
      ]
    },
    "seed": {
      "mode": "all",
      "optional": true,
      "targets": [
        {"class_type": "MiniMaxMusic3TextEncode", "input": "seed", "multi": true},
        {"class_type": "KSampler", "input": "seed", "multi": true},
        {"title": "@seed", "input": "seed", "multi": true}
      ]
    },
    "filename_prefix": {
      "optional": true,
      "targets": [
        {"title": "@output", "input": "filename_prefix"},
        {"class_type": ["SaveAudio", "SaveAudioAdvanced", "SaveAudioMP3", "SaveAudioOpus"], "input": "filename_prefix", "multi": true}
      ]
    }
  }
}
