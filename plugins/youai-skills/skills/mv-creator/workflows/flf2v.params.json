{
  "description": "MiniMax H3 flf2v 参数映射，不能拖入 ComfyUI；请拖入 flf2v.workflow.json 后导出 API。",
  "video_model": "minimax-h3",
  "workflow": "flf2v.api.json",
  "output_ext": [
    ".mp4",
    ".webm",
    ".mov"
  ],
  "params": {
    "start_image": {
      "targets": [
        {
          "title": "@start_image",
          "input": "image"
        },
        {
          "class_type": "LoadImage",
          "input": "image",
          "upstream": {
            "class_type": "MiniMaxH3ImageToVideo",
            "input": "first_frame"
          }
        }
      ],
      "required": true
    },
    "end_image": {
      "targets": [
        {
          "title": "@end_image",
          "input": "image"
        },
        {
          "class_type": "LoadImage",
          "input": "image",
          "upstream": {
            "class_type": "MiniMaxH3ImageToVideo",
            "input": "last_frame"
          }
        }
      ],
      "required": true
    },
    "positive": {
      "targets": [
        {
          "class_type": "MiniMaxH3ImageToVideo",
          "input": "prompt"
        }
      ],
      "required": true
    },
    "width": {
      "targets": [
        {
          "class_type": "MiniMaxH3ImageToVideo",
          "input": "width"
        }
      ]
    },
    "height": {
      "targets": [
        {
          "class_type": "MiniMaxH3ImageToVideo",
          "input": "height"
        }
      ]
    },
    "duration": {
      "targets": [
        {
          "title": "@duration",
          "input": "value"
        },
        {
          "class_type": "PrimitiveFloat",
          "input": "value"
        }
      ]
    },
    "seed": {
      "targets": [
        {
          "title": "@seed",
          "input": "noise_seed"
        },
        {
          "class_type": "RandomNoise",
          "input": "noise_seed"
        }
      ]
    },
    "filename_prefix": {
      "targets": [
        {
          "title": "@output",
          "input": "filename_prefix"
        },
        {
          "class_type": "SaveVideo",
          "input": "filename_prefix"
        }
      ]
    }
  }
}
