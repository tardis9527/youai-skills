{
  "comfyui": {
    "url": "http://127.0.0.1:8188",
    "timeout_sec": 3600,
    "poll_interval_sec": 2,
    "release_between_stages": true,
    "record_resources": true
  },
  "workflows_dir": "workflows",
  "projects_dir": "projects",
  "video": {
    "model": "minimax-h3",
    "width": 864,
    "height": 1536,
    "fps": 24,
    "max_frames": 124,
    "clip_slack_sec": 0.5
  },
  "image": {
    "model": "gpt-image-2",
    "size": "1024x1536",
    "quality": null
  },
  "tardis": {
    "script": null
  },
  "music": {
    "duration_sec": 60,
    "ending_buffer_sec": 30
  },
  "roughcut": {
    "fps": 30,
    "scale": 1.25,
    "crf": 20,
    "font": "Microsoft YaHei"
  },
  "ffmpeg": null,
  "voice": {
    "design_workflow": "tts-design",
    "direction_workflow": "tts-direction",
    "generation": {
      "cfg_scale": 4.0,
      "max_new_tokens": 256
    },
    "music_gain_db": -3,
    "voice_gain_db": 0,
    "duck_db": -6,
    "attack_sec": 0.15,
    "release_sec": 0.25
  }
}
